pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/rohitkolekar840-a11y/node-app.git'
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Build & Push Docker Image') {
            steps {
                // Uses raw docker CLI commands with your credentials configured in Jenkins
                sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USER --password-stdin'
                sh 'docker build -t rohitkolekar/node-app:v1 .'
                sh 'docker push rohitkolekar/node-app:v1'
            }
        }
        
        stage('Deploy') {
            steps {
                sh 'docker stop node-container || true'
                sh 'docker rm node-container || true'
                sh 'docker run -d -p 3000:3000 --name node-container rohitkolekar/node-app:v1'
            }
        }
    }
}